# 环境变量示例
#
# 复制为 .env 或直接 export 后使用。
# 注意：凭据也可以通过 `mi-fitness-mcp setup` 写入系统 keyring，
#       keyring 里的值优先于这里的环境变量。

# 小米账号 userId（浏览器登录 https://account.xiaomi.com 后从 Cookie 取）
MI_FITNESS_USER_ID=replace_me

# 小米账号 passToken（同上，Cookie 里的 passToken）
MI_FITNESS_PASS_TOKEN=replace_me

# 区域：cn（中国大陆）/ ru / sg / i2 等，默认 cn
MI_FITNESS_REGION=cn
